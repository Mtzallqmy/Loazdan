{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "rootDir": "../..", "outDir": "dist", "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../packages/contracts/**/*.ts"]
}
