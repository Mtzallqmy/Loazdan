{
  "name": "@lughzdan/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/services/api/src/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/catalog.integration.test.ts",
    "db:migrate": "node --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "5.12.7",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
