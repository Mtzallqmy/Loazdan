{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "deviceSeq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "kind": {
            "type": "string",
            "enum": [
              "complete_session",
              "save_word",
              "set_preference"
            ]
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "operationId",
          "deviceId",
          "deviceSeq",
          "kind",
          "payload"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "complete_session"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sessionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "puzzleId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "puzzleRevision": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "rulesVersion": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2147483647
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "won",
                        "lost",
                        "abandoned"
                      ]
                    },
                    "score": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 300
                    },
                    "wrongSubmissions": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "hintIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "minItems": 0,
                      "maxItems": 10
                    },
                    "durationMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    }
                  },
                  "required": [
                    "sessionId",
                    "puzzleId",
                    "puzzleRevision",
                    "rulesVersion",
                    "outcome",
                    "score",
                    "wrongSubmissions",
                    "hintIds",
                    "durationMs"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "save_word"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "vocabularyId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "saved": {
                      "type": "boolean"
                    },
                    "baseVersion": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "vocabularyId",
                    "saved",
                    "baseVersion"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "set_preference"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string",
                      "enum": [
                        "theme",
                        "sound",
                        "reducedMotion"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "enum": [
                        "light",
                        "dark",
                        "system",
                        "on",
                        "off"
                      ]
                    },
                    "baseVersion": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "key",
                    "value",
                    "baseVersion"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "key": {
                            "const": "theme"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "string",
                            "enum": [
                              "light",
                              "dark",
                              "system"
                            ]
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "value": {
                            "type": "string",
                            "enum": [
                              "on",
                              "off"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "operations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
